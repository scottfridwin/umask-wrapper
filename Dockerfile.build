# Builds a static umask-wrapper and runs test.sh against it on each target platform.
# docker buildx build --platform linux/amd64,linux/arm64,linux/arm/v7,linux/386 -f Dockerfile.build -o dist .
FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS build
RUN apk add --no-cache gcc musl-dev
COPY umask-wrapper.c /src/
RUN gcc -static -Os -Wall -Wextra -Werror -o /umask-wrapper /src/umask-wrapper.c \
    && strip /umask-wrapper

FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS test
COPY --from=build /umask-wrapper /usr/local/bin/umask-wrapper
COPY test.sh /test.sh
RUN sh /test.sh /usr/local/bin/umask-wrapper

# Exporting from the test stage means a binary is only produced if its tests passed
FROM scratch
COPY --from=test /usr/local/bin/umask-wrapper /umask-wrapper
